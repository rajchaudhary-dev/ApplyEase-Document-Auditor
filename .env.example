# Gemini API Key (Get from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Application Configuration
DATABASE_URL=sqlite:///./applyease_dossier.db
BUCKET_STORAGE_DIR=./storage_bucket
MAX_PHOTO_SIZE_KB=50
MIN_PHOTO_SIZE_KB=20
MAX_SIG_SIZE_KB=20
MIN_SIG_SIZE_KB=10
DEFAULT_GEMINI_MODEL=gemini-3.8-flash
